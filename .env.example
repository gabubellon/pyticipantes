# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Porta publicada no host e interface de escuta (padrão: só localhost)
PYTICIPANTES_PORTA=8000
PYTICIPANTES_BIND=127.0.0.1

# Proteção por senha (HTTP Basic). OBRIGATÓRIO se expor fora do localhost sem proxy autenticado.
PYTICIPANTES_USUARIO=
PYTICIPANTES_SENHA=

# Fora do Docker: onde guardar dados e PDFs (padrão ./data e ./saida)
# PYTICIPANTES_DATA=/caminho/data
# PYTICIPANTES_SAIDA=/caminho/saida
